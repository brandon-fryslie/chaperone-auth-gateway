// testEnvProvider validates the environment variable secret provider.
//
// Gaming Resistance:
// - Tests use REAL environment variables (os.Setenv/os.Getenv)
// - Tests verify actual environment variable retrieval
// - Cannot be satisfied by mocks or hardcoded responses
func testEnvProvider(t *testing.T) {
	t.Run("fetch_existing_variable", testEnvFetchExisting)
	t.Run("fetch_missing_variable", testEnvFetchMissing)
	t.Run("fetch_empty_variable", testEnvFetchEmpty)
	t.Run("variable_name_validation", testEnvVariableNameValidation)
	t.Run("context_cancellation", testEnvContextCancellation)
}

func testEnvFetchExisting(t *testing.T) {
	// This test validates fetching an existing environment variable.
	// Gaming Resistance:
	// - Uses REAL os.Setenv and os.Getenv
	// - Verifies actual environment variable retrieval
	// - Cannot be faked with stubs

	cleanup := setupEnvVar(t, "TEST_SECRET", "sk-test-key-123")
	defer cleanup()

	provider := secrets.NewEnvProvider()
	secret, err := provider.Fetch(context.Background(), "TEST_SECRET")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)
}

func testEnvFetchMissing(t *testing.T) {
	// This test validates fetching a missing environment variable.
	// Gaming Resistance:
	// - Verifies ErrSecretNotFound is returned
	// - Tests actual error handling path

	os.Unsetenv("MISSING_VAR")

	provider := secrets.NewEnvProvider()
	_, err := provider.Fetch(context.Background(), "MISSING_VAR")
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)
}

func testEnvFetchEmpty(t *testing.T) {
	// This test validates that empty string values return ErrSecretNotFound.
	// Gaming Resistance:
	// - Uses REAL environment variable with empty value
	// - Verifies error handling for empty secrets

	cleanup := setupEnvVar(t, "EMPTY_SECRET", "")
	defer cleanup()

	provider := secrets.NewEnvProvider()
	_, err := provider.Fetch(context.Background(), "EMPTY_SECRET")
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)
}

func testEnvVariableNameValidation(t *testing.T) {
	// This test validates variable name format (alphanumeric + underscore only).
	// Gaming Resistance:
	// - Tests actual validation logic
	// - Cannot be satisfied by skipping validation

	provider := secrets.NewEnvProvider()

	// Valid names should work
	validNames := []string{"API_KEY", "OPENAI_API_KEY", "SECRET_123"}
	for _, name := range validNames {
		cleanup := setupEnvVar(t, name, "test-value")
		_, err := provider.Fetch(context.Background(), name)
		assert.NoError(t, err, "valid name %s should work", name)
		cleanup()
	}

	// Invalid names should fail
	invalidNames := []string{"api-key", "api.key", "api key"}
	for _, name := range invalidNames {
		_, err := provider.Fetch(context.Background(), name)
		assert.Error(t, err, "invalid name %s should fail", name)
	}
}

func testEnvContextCancellation(t *testing.T) {
	// This test validates context cancellation is respected.
	// Gaming Resistance:
	// - Uses real context cancellation
	// - Verifies actual context.Done() handling

	cleanup := setupEnvVar(t, "TEST_SECRET", "value")
	defer cleanup()

	ctx, cancel := context.WithCancel(context.Background())
	cancel() // Cancel immediately

	provider := secrets.NewEnvProvider()
	_, err := provider.Fetch(ctx, "TEST_SECRET")
	require.Error(t, err)
	assert.ErrorIs(t, err, context.Canceled)
}

// ============================================================================
// CHAP-2iw: file: Provider Tests
// ============================================================================

// testFileProvider validates the file-based secret provider with permission checks.
//
// Gaming Resistance:
// - Tests create REAL files on disk (os.WriteFile)
// - Tests set REAL file permissions (os.Chmod)
// - Tests verify ACTUAL file mode bits (os.Stat)
// - Cannot be satisfied by mocks or fake filesystem
func testFileProvider(t *testing.T) {
	t.Run("fetch_with_0600_permissions", testFileFetch0600)
	t.Run("fetch_with_0400_permissions", testFileFetch0400)
	t.Run("reject_0644_permissions", testFileReject0644)
	t.Run("reject_0666_permissions", testFileReject0666)
	t.Run("reject_0777_permissions", testFileReject0777)
	t.Run("missing_file", testFileMissing)
	t.Run("large_file_rejected", testFileLargeFileRejected)
	t.Run("whitespace_trimmed", testFileWhitespaceTrimmed)
	t.Run("empty_file_rejected", testFileEmptyRejected)
	t.Run("symbolic_links", testFileSymbolicLinks)
}

func testFileFetch0600(t *testing.T) {
	// This test validates fetching a file with 0600 (rw-------) permissions.
	// Gaming Resistance:
	// - Creates REAL file on disk
	// - Sets REAL permissions with os.Chmod
	// - Verifies actual file content retrieval

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("sk-test-key-123"), 0600))

	provider := secrets.NewFileProvider()
	secret, err := provider.Fetch(context.Background(), secretFile)
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)
}

func testFileFetch0400(t *testing.T) {
	// This test validates fetching a file with 0400 (r--------) permissions.
	// Gaming Resistance:
	// - Creates REAL file with read-only permissions
	// - Verifies provider accepts read-only files

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("sk-test-key-123"), 0400))

	provider := secrets.NewFileProvider()
	secret, err := provider.Fetch(context.Background(), secretFile)
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)
}

func testFileReject0644(t *testing.T) {
	// This test validates rejection of files with 0644 (rw-r--r--) permissions.
	// Gaming Resistance:
	// - Creates REAL file with world-readable permissions
	// - Verifies ACTUAL permission check using os.Stat
	// - Cannot be satisfied by skipping permission check

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("sk-test-key-123"), 0644))

	provider := secrets.NewFileProvider()
	_, err := provider.Fetch(context.Background(), secretFile)
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrPermissionDenied)
	assert.Contains(t, err.Error(), "file permissions too permissive")
}

func testFileReject0666(t *testing.T) {
	// This test validates rejection of files with 0666 (rw-rw-rw-) permissions.
	// Gaming Resistance:
	// - Creates REAL file with group and world writable permissions
	// - Verifies permission denial

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("sk-test-key-123"), 0666))

	provider := secrets.NewFileProvider()
	_, err := provider.Fetch(context.Background(), secretFile)
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrPermissionDenied)
}

func testFileReject0777(t *testing.T) {
	// This test validates rejection of files with 0777 (rwxrwxrwx) permissions.
	// Gaming Resistance:
	// - Creates REAL file with full permissions
	// - Verifies security check rejects overly permissive files

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("sk-test-key-123"), 0777))

	provider := secrets.NewFileProvider()
	_, err := provider.Fetch(context.Background(), secretFile)
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrPermissionDenied)
}

func testFileMissing(t *testing.T) {
	// This test validates handling of missing files.
	// Gaming Resistance:
	// - References non-existent file path
	// - Verifies ErrSecretNotFound is returned

	provider := secrets.NewFileProvider()
	_, err := provider.Fetch(context.Background(), "/nonexistent/path/to/secret.txt")
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)
}

func testFileLargeFileRejected(t *testing.T) {
	// This test validates file size limit enforcement (max 1MB).
	// Gaming Resistance:
	// - Creates REAL file larger than 1MB
	// - Verifies actual size check

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "large.txt")

	// Create file larger than 1MB
	largeContent := strings.Repeat("x", 1024*1024+1)
	require.NoError(t, os.WriteFile(secretFile, []byte(largeContent), 0600))

	provider := secrets.NewFileProvider()
	_, err := provider.Fetch(context.Background(), secretFile)
	require.Error(t, err)
	assert.Contains(t, err.Error(), "file too large")
}

func testFileWhitespaceTrimmed(t *testing.T) {
	// This test validates whitespace trimming from file content.
	// Gaming Resistance:
	// - Creates REAL file with leading/trailing whitespace
	// - Verifies actual string trimming

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("  \n\tsk-test-key-123\n\t  "), 0600))

	provider := secrets.NewFileProvider()
	secret, err := provider.Fetch(context.Background(), secretFile)
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)
}

func testFileEmptyRejected(t *testing.T) {
	// This test validates empty files are rejected.
	// Gaming Resistance:
	// - Creates REAL empty file
	// - Creates REAL file with only whitespace
	// - Verifies ErrSecretNotFound is returned

	tmpDir := t.TempDir()

	// Empty file
	emptyFile := filepath.Join(tmpDir, "empty.txt")
	require.NoError(t, os.WriteFile(emptyFile, []byte(""), 0600))

	provider := secrets.NewFileProvider()
	_, err := provider.Fetch(context.Background(), emptyFile)
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)

	// Whitespace-only file
	whitespaceFile := filepath.Join(tmpDir, "whitespace.txt")
	require.NoError(t, os.WriteFile(whitespaceFile, []byte("   \n\t   \n"), 0600))

	_, err = provider.Fetch(context.Background(), whitespaceFile)
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)
}

func testFileSymbolicLinks(t *testing.T) {
	// This test validates symbolic link handling.
	// Gaming Resistance:
	// - Creates REAL symbolic link on filesystem
	// - Verifies permission check on target file, not link

	tmpDir := t.TempDir()
	targetFile := filepath.Join(tmpDir, "target.txt")
	require.NoError(t, os.WriteFile(targetFile, []byte("sk-test-key-123"), 0600))

	linkFile := filepath.Join(tmpDir, "link.txt")
	require.NoError(t, os.Symlink(targetFile, linkFile))

	provider := secrets.NewFileProvider()
	secret, err := provider.Fetch(context.Background(), linkFile)
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)

	// Now test with overly permissive target
	require.NoError(t, os.Chmod(targetFile, 0644))
	_, err = provider.Fetch(context.Background(), linkFile)
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrPermissionDenied)
}

// ============================================================================
// CHAP-vwg: Secret Caching Tests
// ============================================================================

// testSecretCaching validates the secret caching layer with 5-minute TTL.
//
// Gaming Resistance:
// - Tests use REAL time.Now() and time.Sleep()
// - Tests verify ACTUAL time-based expiration
// - Tests use REAL goroutines for concurrent access
// - Cannot be satisfied by fake timers or mocks
func testSecretCaching(t *testing.T) {
	t.Run("cache_hit", testCacheHit)
	t.Run("cache_miss", testCacheMiss)
	t.Run("cache_expiration", testCacheExpiration)
	t.Run("cache_invalidation", testCacheInvalidation)
	t.Run("cache_clear", testCacheClear)
	t.Run("cache_stats", testCacheStats)
	t.Run("concurrent_cache_access", testConcurrentCacheAccess)
	t.Run("negative_caching", testNegativeCaching)
}

func testCacheHit(t *testing.T) {
	// This test validates cache hit returns cached value.
	// Gaming Resistance:
	// - Uses real provider wrapped with caching
	// - Verifies provider is only called once
	// - Second fetch must return cached value

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// First fetch - cache miss, calls provider
	secret1, err := cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret1)
	assert.Equal(t, 1, mockProvider.getCallCount())

	// Second fetch - cache hit, does NOT call provider
	secret2, err := cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret2)
	assert.Equal(t, 1, mockProvider.getCallCount()) // Still 1 - not called again
}

func testCacheMiss(t *testing.T) {
	// This test validates cache miss calls underlying provider.
	// Gaming Resistance:
	// - Verifies provider is called on cache miss
	// - Tests different credential_refs have separate cache entries

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// Fetch ref1 - cache miss
	secret1, err := cached.Fetch(context.Background(), "test:ref1")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret1)
	assert.Equal(t, 1, mockProvider.getCallCount())

	// Fetch ref2 - cache miss (different ref)
	secret2, err := cached.Fetch(context.Background(), "test:ref2")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret2)
	assert.Equal(t, 2, mockProvider.getCallCount())
}

func testCacheExpiration(t *testing.T) {
	// This test validates cache entries expire after TTL.
	// Gaming Resistance:
	// - Uses REAL time.Now() and time.Sleep()
	// - Verifies ACTUAL time-based expiration
	// - Cannot be satisfied by fake timers

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 100*time.Millisecond) // Short TTL for testing

	// First fetch - cache miss
	_, err := cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, 1, mockProvider.getCallCount())

	// Second fetch - cache hit (within TTL)
	time.Sleep(50 * time.Millisecond)
	_, err = cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, 1, mockProvider.getCallCount())

	// Third fetch - cache expired (after TTL)
	time.Sleep(100 * time.Millisecond)
	_, err = cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, 2, mockProvider.getCallCount()) // Called again after expiration
}

func testCacheInvalidation(t *testing.T) {
	// This test validates manual cache invalidation.
	// Gaming Resistance:
	// - Verifies Invalidate() removes cache entry
	// - Next fetch must call provider again

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// First fetch - cache miss
	_, err := cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, 1, mockProvider.getCallCount())

	// Invalidate cache entry
	cached.Invalidate("test:ref")

	// Second fetch - cache miss again (invalidated)
	_, err = cached.Fetch(context.Background(), "test:ref")
	require.NoError(t, err)
	assert.Equal(t, 2, mockProvider.getCallCount())
}

func testCacheClear(t *testing.T) {
	// This test validates Clear() removes all cache entries.
	// Gaming Resistance:
	// - Verifies all entries removed
	// - Multiple refs must all be refetched

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// Fetch multiple refs
	_, err := cached.Fetch(context.Background(), "test:ref1")
	require.NoError(t, err)
	_, err = cached.Fetch(context.Background(), "test:ref2")
	require.NoError(t, err)
	assert.Equal(t, 2, mockProvider.getCallCount())

	// Clear entire cache
	cached.Clear()

	// Fetch both refs again - both should be cache misses
	_, err = cached.Fetch(context.Background(), "test:ref1")
	require.NoError(t, err)
	_, err = cached.Fetch(context.Background(), "test:ref2")
	require.NoError(t, err)
	assert.Equal(t, 4, mockProvider.getCallCount())
}

func testCacheStats(t *testing.T) {
	// This test validates cache statistics tracking.
	// Gaming Resistance:
	// - Verifies actual hit/miss counts
	// - Verifies actual cache size

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// Initial stats
	stats := cached.Stats()
	assert.Equal(t, 0, stats.Hits)
	assert.Equal(t, 0, stats.Misses)
	assert.Equal(t, 0, stats.Size)

	// First fetch - miss
	_, err := cached.Fetch(context.Background(), "test:ref1")
	require.NoError(t, err)
	stats = cached.Stats()
	assert.Equal(t, 0, stats.Hits)
	assert.Equal(t, 1, stats.Misses)
	assert.Equal(t, 1, stats.Size)

	// Second fetch same ref - hit
	_, err = cached.Fetch(context.Background(), "test:ref1")
	require.NoError(t, err)
	stats = cached.Stats()
	assert.Equal(t, 1, stats.Hits)
	assert.Equal(t, 1, stats.Misses)
	assert.Equal(t, 1, stats.Size)

	// Fetch different ref - miss
	_, err = cached.Fetch(context.Background(), "test:ref2")
	require.NoError(t, err)
	stats = cached.Stats()
	assert.Equal(t, 1, stats.Hits)
	assert.Equal(t, 2, stats.Misses)
	assert.Equal(t, 2, stats.Size)
}

func testConcurrentCacheAccess(t *testing.T) {
	// This test validates thread-safe concurrent cache access.
	// Gaming Resistance:
	// - Uses REAL goroutines
	// - Must pass with `go test -race`
	// - Verifies actual concurrent access safety

	innerRegistry := secrets.NewRegistry()
	mockProvider := &countingProvider{secret: "sk-test-key-123"}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	var wg sync.WaitGroup
	for i := 0; i < 100; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			secret, err := cached.Fetch(context.Background(), "test:ref")
			require.NoError(t, err)
			assert.Equal(t, "sk-test-key-123", secret)
		}()
	}
	wg.Wait()

	// Provider should only be called once (first goroutine)
	// All other goroutines should get cached value
	assert.Equal(t, 1, mockProvider.getCallCount())
}

func testNegativeCaching(t *testing.T) {
	// This test validates caching of errors (negative caching).
	// Gaming Resistance:
	// - Verifies errors are cached too
	// - Prevents hammering failing providers

	innerRegistry := secrets.NewRegistry()
	mockProvider := &failingProvider{err: errors.ErrSecretNotFound}
	innerRegistry.Register("test", mockProvider)

	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// First fetch - error, calls provider
	_, err := cached.Fetch(context.Background(), "test:missing")
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)
	assert.Equal(t, 1, mockProvider.getCallCount())

	// Second fetch - cached error, does NOT call provider again
	_, err = cached.Fetch(context.Background(), "test:missing")
	require.Error(t, err)
	assert.ErrorIs(t, err, errors.ErrSecretNotFound)
	assert.Equal(t, 1, mockProvider.getCallCount()) // Still 1
}

// ============================================================================
// Integration Tests: Full Secret Management Flow
// ============================================================================

// testSecretsIntegration validates the complete secret management flow
// end-to-end using the Fetch() convenience function.
//
// Gaming Resistance:
// - Tests complete flow from credential_ref to secret retrieval
// - Uses REAL environment variables and files
// - Verifies actual provider registry and parsing
// - Cannot be satisfied by mocks
func testSecretsIntegration(t *testing.T) {
	t.Run("fetch_env_secret", testIntegrationFetchEnvSecret)
	t.Run("fetch_file_secret", testIntegrationFetchFileSecret)
	t.Run("fetch_unknown_protocol", testIntegrationUnknownProtocol)
	t.Run("end_to_end_with_caching", testIntegrationEndToEndWithCaching)
}

func testIntegrationFetchEnvSecret(t *testing.T) {
	// This test validates end-to-end env: secret fetching.
	// Gaming Resistance:
	// - Uses REAL environment variable
	// - Tests complete flow: parse → registry → provider → secret

	cleanup := setupEnvVar(t, "OPENAI_API_KEY", "sk-test-key-123")
	defer cleanup()

	registry := secrets.NewRegistry()
	registry.Register("env", secrets.NewEnvProvider())

	secret, err := registry.Fetch(context.Background(), "env:OPENAI_API_KEY")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)
}

func testIntegrationFetchFileSecret(t *testing.T) {
	// This test validates end-to-end file: secret fetching.
	// Gaming Resistance:
	// - Creates REAL file on disk
	// - Tests complete flow: parse → registry → provider → secret

	tmpDir := t.TempDir()
	secretFile := filepath.Join(tmpDir, "secret.txt")
	require.NoError(t, os.WriteFile(secretFile, []byte("sk-test-key-123"), 0600))

	registry := secrets.NewRegistry()
	registry.Register("file", secrets.NewFileProvider())

	ref := "file:" + secretFile
	secret, err := registry.Fetch(context.Background(), ref)
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret)
}

func testIntegrationUnknownProtocol(t *testing.T) {
	// This test validates error handling for unknown protocols.
	// Gaming Resistance:
	// - Tests actual error path
	// - Verifies provider registry returns appropriate error

	registry := secrets.NewRegistry()

	_, err := registry.Fetch(context.Background(), "vault:secret/openai/key")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "provider not found")
}

func testIntegrationEndToEndWithCaching(t *testing.T) {
	// This test validates complete flow with caching enabled.
	// Gaming Resistance:
	// - Uses REAL environment variable
	// - Uses REAL caching layer
	// - Verifies cache reduces provider calls

	cleanup := setupEnvVar(t, "TEST_SECRET", "sk-test-key-123")
	defer cleanup()

	innerRegistry := secrets.NewRegistry()
	innerRegistry.Register("env", secrets.NewEnvProvider())
	cached := secrets.NewCachedRegistry(innerRegistry, 5*time.Minute)

	// First fetch - cache miss
	secret1, err := cached.Fetch(context.Background(), "env:TEST_SECRET")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret1)

	// Change environment variable
	cleanup2 := setupEnvVar(t, "TEST_SECRET", "sk-new-key-456")
	defer cleanup2()

	// Second fetch - cache hit (still returns old value)
	secret2, err := cached.Fetch(context.Background(), "env:TEST_SECRET")
	require.NoError(t, err)
	assert.Equal(t, "sk-test-key-123", secret2) // Cached value

	// Clear cache
	cached.Clear()

	// Third fetch - cache miss (returns new value)
	secret3, err := cached.Fetch(context.Background(), "env:TEST_SECRET")
	require.NoError(t, err)
	assert.Equal(t, "sk-new-key-456", secret3) // New value
}

// ============================================================================
// Test Helpers
// ============================================================================

// mockSecretProvider is a simple mock for registry tests.
type mockSecretProvider struct{}

func (p *mockSecretProvider) Fetch(ctx context.Context, ref string) (string, error) {
	return "mock-secret", nil
}

// countingProvider is a test provider that counts fetch calls.
// Used to verify caching behavior.
type countingProvider struct {
	mu        sync.Mutex
	secret    string
	callCount int
}

func (p *countingProvider) Fetch(ctx context.Context, ref string) (string, error) {
	p.mu.Lock()
	p.callCount++
	p.mu.Unlock()
	return p.secret, nil
}

// failingProvider is a test provider that always returns an error.
// Used to verify negative caching.
type failingProvider struct {
	mu        sync.Mutex
	err       error
	callCount int
}

func (p *failingProvider) Fetch(ctx context.Context, ref string) (string, error) {
	p.mu.Lock()
	p.callCount++
	p.mu.Unlock()
	return "", p.err
}

// setupEnvVar sets an environment variable and returns a cleanup function.
func setupEnvVar(t *testing.T, name, value string) func() {
	oldValue, existed := os.LookupEnv(name)
	os.Setenv(name, value)
	return func() {
		if existed {
			os.Setenv(name, oldValue)
		} else {
			os.Unsetenv(name)
		}
	}
}

func (p *countingProvider) getCallCount() int {
	p.mu.Lock()
	defer p.mu.Unlock()
	return p.callCount
}

func (p *failingProvider) getCallCount() int {
	p.mu.Lock()
	defer p.mu.Unlock()
	return p.callCount
}
