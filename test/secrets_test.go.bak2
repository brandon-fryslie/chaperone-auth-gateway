package test

import (
	"context"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"testing"
	"time"

	"github.com/bmf/chaperone/internal/errors"
	"github.com/bmf/chaperone/internal/secrets"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// TestPhase3_SecretManagement is the comprehensive test suite for Phase 3 (Secret Management).
//
// This test suite validates:
// - CHAP-txf: SecretProvider interface + registry + credential_ref parser
// - CHAP-i81: env: provider implementation
// - CHAP-2iw: file: provider with 0600 permission checks
// - CHAP-vwg: Secret caching with 5-minute TTL
//
// Gaming Resistance: These tests cannot be satisfied by stubs because:
// 1. credential_ref parser tests use real strings and verify actual parsing logic
// 2. env: provider tests use REAL environment variables (os.Setenv/os.Getenv)
// 3. file: provider tests create REAL files on disk with REAL permissions (os.WriteFile, os.Chmod)
// 4. Permission tests verify ACTUAL file mode bits (os.Stat)
// 5. Caching tests verify ACTUAL time-based expiration with real time.Now() and time.Sleep()
// 6. Concurrent tests use REAL goroutines and verify thread safety
// 7. Integration tests exercise the complete flow end-to-end
//
// An AI cannot fake these tests with mocks - the real secret management system must work.
func TestPhase3_SecretManagement(t *testing.T) {
	t.Run("credential_ref_parser", testCredentialRefParser)
	t.Run("provider_registry", testProviderRegistry)
	t.Run("env_provider", testEnvProvider)
	t.Run("file_provider", testFileProvider)
	t.Run("secret_caching", testSecretCaching)
	t.Run("integration", testSecretsIntegration)
}

// ============================================================================
// CHAP-txf: Credential Reference Parser Tests
// ============================================================================

// testCredentialRefParser validates the credential_ref parser that splits
// "protocol:path" format into protocol and path components.
//
// Gaming Resistance:
// - Tests use actual string parsing, not mocks
// - Multiple edge cases tested to ensure robust implementation
// - Cannot be satisfied by hardcoded responses
func testCredentialRefParser(t *testing.T) {
	t.Run("parse_env_reference", testParseEnvReference)
	t.Run("parse_file_reference", testParseFileReference)
	t.Run("parse_file_with_absolute_path", testParseFileWithAbsolutePath)
	t.Run("parse_windows_path", testParseWindowsPath)
	t.Run("parse_multiple_colons", testParseMultipleColons)
	t.Run("parse_missing_colon", testParseMissingColon)
	t.Run("parse_empty_string", testParseEmptyString)
	t.Run("parse_empty_protocol", testParseEmptyProtocol)
	t.Run("parse_empty_path", testParseEmptyPath)
}

func testParseEnvReference(t *testing.T) {
	// Parse "env:OPENAI_API_KEY" → protocol="env", path="OPENAI_API_KEY"
	protocol, path, err := secrets.ParseCredentialRef("env:OPENAI_API_KEY")
	require.NoError(t, err)
	assert.Equal(t, "env", protocol)
	assert.Equal(t, "OPENAI_API_KEY", path)
}

func testParseFileReference(t *testing.T) {
	// Parse "file:/path/to/secret.txt" → protocol="file", path="/path/to/secret.txt"
	protocol, path, err := secrets.ParseCredentialRef("file:/path/to/secret.txt")
	require.NoError(t, err)
	assert.Equal(t, "file", protocol)
	assert.Equal(t, "/path/to/secret.txt", path)
}

func testParseFileWithAbsolutePath(t *testing.T) {
	// Parse "file:/tmp/secret.txt" → protocol="file", path="/tmp/secret.txt"
	protocol, path, err := secrets.ParseCredentialRef("file:/tmp/secret.txt")
	require.NoError(t, err)
	assert.Equal(t, "file", protocol)
	assert.Equal(t, "/tmp/secret.txt", path)
}

func testParseWindowsPath(t *testing.T) {
	// Parse "file:C:/path/to/secret.txt" on Windows
	// Should handle colon in drive letter correctly
	protocol, path, err := secrets.ParseCredentialRef("file:C:/path/to/secret.txt")
	require.NoError(t, err)
	assert.Equal(t, "file", protocol)
	assert.Equal(t, "C:/path/to/secret.txt", path)
}

func testParseMultipleColons(t *testing.T) {
	// Parse "file:/path/with:colon/secret.txt" → should split on FIRST colon only
	protocol, path, err := secrets.ParseCredentialRef("file:/path/with:colon/secret.txt")
	require.NoError(t, err)
	assert.Equal(t, "file", protocol)
	assert.Equal(t, "/path/with:colon/secret.txt", path)
}

func testParseMissingColon(t *testing.T) {
	// Parse "env_OPENAI_API_KEY" (no colon) → should return error
	_, _, err := secrets.ParseCredentialRef("env_OPENAI_API_KEY")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "invalid credential_ref format")
}

func testParseEmptyString(t *testing.T) {
	// Parse "" → should return error
	_, _, err := secrets.ParseCredentialRef("")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "empty credential_ref")
}

func testParseEmptyProtocol(t *testing.T) {
	// Parse ":OPENAI_API_KEY" → should return error
	_, _, err := secrets.ParseCredentialRef(":OPENAI_API_KEY")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "empty protocol")
}

func testParseEmptyPath(t *testing.T) {
	// Parse "env:" → should return error
	_, _, err := secrets.ParseCredentialRef("env:")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "empty path")
}

// ============================================================================
// CHAP-txf: Provider Registry Tests
// ============================================================================

// testProviderRegistry validates the provider registry that stores and
// retrieves SecretProvider implementations by protocol name.
//
// Gaming Resistance:
// - Tests use real registry implementation, not mocks
// - Tests verify actual provider registration and retrieval
// - Concurrent access tested with real goroutines
func testProviderRegistry(t *testing.T) {
	t.Run("register_and_retrieve_provider", testRegisterAndRetrieveProvider)
	t.Run("retrieve_unknown_provider", testRetrieveUnknownProvider)
	t.Run("register_multiple_providers", testRegisterMultipleProviders)
	t.Run("concurrent_access", testRegistryConcurrentAccess)
}

func testRegisterAndRetrieveProvider(t *testing.T) {
	registry := secrets.NewRegistry()
	mockProvider := &mockSecretProvider{}

	registry.Register("test", mockProvider)
	provider, err := registry.Get("test")
	require.NoError(t, err)
	assert.Equal(t, mockProvider, provider)
}

func testRetrieveUnknownProvider(t *testing.T) {
	registry := secrets.NewRegistry()
	_, err := registry.Get("unknown")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "provider not found")
}

func testRegisterMultipleProviders(t *testing.T) {
	registry := secrets.NewRegistry()
	envProvider := &mockSecretProvider{}
	fileProvider := &mockSecretProvider{}

	registry.Register("env", envProvider)
	registry.Register("file", fileProvider)

	env, err := registry.Get("env")
	require.NoError(t, err)
	assert.Equal(t, envProvider, env)

	file, err := registry.Get("file")
	require.NoError(t, err)
	assert.Equal(t, fileProvider, file)
}

func testRegistryConcurrentAccess(t *testing.T) {
	// This test validates thread-safe concurrent access to the registry.
	// Gaming Resistance:
	// - Uses real goroutines and sync primitives
	// - Tests must pass with `go test -race`
	// - Cannot be satisfied by single-threaded mocks

	registry := secrets.NewRegistry()
	registry.Register("test", &mockSecretProvider{})

	var wg sync.WaitGroup
	for i := 0; i < 100; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			provider, err := registry.Get("test")
			require.NoError(t, err)
			require.NotNil(t, provider)
		}()
	}
	wg.Wait()
}

