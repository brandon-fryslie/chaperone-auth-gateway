    // They will execute in REVERSE order

    // Database close (executes LAST)
    mgr.Register(func(ctx context.Context) error {
        return db.Close()
    })

    // HTTP server shutdown (executes SECOND)
    mgr.Register(func(ctx context.Context) error {
        return server.Shutdown(ctx)
