				errors[clientID] = err
				return
			}
			defer resp.Body.Close()

			body, err := io.ReadAll(resp.Body)
			if err != nil {
				errors[clientID] = err
				return
			}

			responses[clientID] = string(body)
		}(i)
	}

	wg.Wait()

	// Verify isolation
