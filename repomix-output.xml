// internal/auth/header.go (NEW)
package auth

import (
    "context"
    "fmt"
    "net/http"

    "github.com/bmf/chaperone/internal/errors"
    "github.com/bmf/chaperone/internal/log"
)

type HeaderStrategy struct {
    HeaderName string
}

func (s *HeaderStrategy) Apply(ctx context.Context, req *http.Request, secret string) error {
    if secret == "" {
        return errors.ErrSecretNotFound
    }
    if s.HeaderName == "" {
        return fmt.Errorf("header name not configured")
    }

    // Clone request to avoid mutation
    cloned := CloneRequest(req)

    // Set custom header
    cloned.Header.Set(s.HeaderName, secret)

    log.Debug(ctx, "injected custom header authentication", "header", s.HeaderName)

    *req = *cloned
    return nil
}

func init() {
