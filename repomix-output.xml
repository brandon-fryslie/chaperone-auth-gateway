		},
		Logging: config.LoggingConfig{
			Level:  "info",
			Format: "json",
			Output: "stdout",
		},
	}

	// Create empty service registry
	registry := service.NewRegistry()

	// Create certificate cache
	certCache := mitm.NewCertCache(ca)

