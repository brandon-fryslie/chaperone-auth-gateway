  misspell:
    # Correct spellings using locale
    locale: US

# Linters to enable
linters:
  enable:
    - errcheck      # Check for unchecked errors
    - gosimple      # Simplify code
    - govet         # Report suspicious constructs
    - ineffassign   # Detect ineffectual assignments
    - staticcheck   # Go static analysis
    - unused        # Check for unused code
    - gofmt         # Check whether code was gofmt-ed
    - goimports     # Check import statements are formatted
    - misspell      # Find commonly misspelled words
    - revive        # Fast, configurable, extensible linter
    - gosec         # Security-focused linter
    - exportloopref # Checks for pointers to enclosing loop variables

  # Disable these linters
  disable:
    - deadcode      # Deprecated
    - varcheck      # Deprecated
    - structcheck   # Deprecated
    - golint        # Deprecated, use revive instead

# Issues configuration
issues:
  # Maximum issues count per linter
  max-issues-per-linter: 0

  # Maximum count of issues with the same text
  max-same-issues: 0

  # Exclude test files from some linters
  exclude-rules:
    - path: _test\.go
      linters:
        - gosec
        - errcheck
</file>

