	defer upstreamServer.Close()

	// Create config with NO service for this upstream (should use transparent tunnel)
	proxyPort := findAvailablePort(t)
	cfg := &config.Config{
		Server: config.ServerConfig{
			Address: "127.0.0.1",
			Port:    proxyPort,
		},
		Services: map[string]config.ServiceConfig{
